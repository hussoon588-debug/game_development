# PostgreSQL connection string. Use a managed PostgreSQL provider in production.
DATABASE_URL=postgresql://postgres:change-me@localhost:5432/realestate_game
POSTGRES_PASSWORD=replace-with-a-unique-long-random-password

# Same OAuth web client ID in server and browser configuration.
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Change to a unique random password of at least 16 characters.
ADMIN_PASSWORD=replace-with-a-long-random-secret

# Keep false/unset in production. Only enable in isolated demo environments.
ALLOW_DEMO_SEED=false

# Set to production on the hosting platform; do not disable TLS verification.
NODE_ENV=development
